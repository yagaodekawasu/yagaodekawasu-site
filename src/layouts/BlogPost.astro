---
import type { CollectionEntry } from "astro:content";
import { render, getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import SeriesBox from "../components/SeriesBox.astro";
import { formatDate, isLaterDay } from "../lib/date-format.mjs";
import { getGitLastModified } from "../lib/git-last-modified.mjs";

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { title, description, pubDate, tags, ogpImage, series } = entry.data;

const gitLastModified = entry.filePath ? getGitLastModified(entry.filePath) : null;
const updatedDate =
  gitLastModified && isLaterDay(gitLastModified, pubDate) ? gitLastModified : undefined;

const { Content, headings } = await render(entry);
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const seriesItems = series
  ? (await getCollection("blog", ({ data }) => !data.draft && data.series?.name === series.name))
      .map((post) => ({ id: post.id, order: post.data.series!.order, label: post.data.series!.label }))
      .sort((a, b) => a.order - b.order)
  : [];

const profiles = await getCollection("profile");
const authorName = profiles[0]?.data.name;

const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
const shareText = `${title} | 笶顔でかわす`;
const tweetIntentUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(ogpImage && { image: new URL(ogpImage, Astro.site).toString() }),
  ...(authorName && { author: { "@type": "Person", name: authorName } }),
};
---

<BaseLayout title={`${title} | 笶顔でかわす`} description={description} ogImage={ogpImage} ogType="article" jsonLd={jsonLd} wide>
  <div class="lg:flex lg:gap-8">
    <article class="prose max-w-none lg:max-w-3xl lg:flex-1 min-w-0">
      {tags.length > 0 && (
        <div class="flex gap-2 mb-3 not-prose">
          {tags.map((tag) => (
            <span class="badge badge-outline">{tag}</span>
          ))}
        </div>
      )}
      <h1>{title}</h1>
      <div class="flex items-center gap-3 text-sm text-base-content/60 mb-6">
        <span class="inline-flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-3.5 w-3.5 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </span>
        {updatedDate && (
          <span class="inline-flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-3.5 w-3.5 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
            <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
          </span>
        )}
      </div>
      {ogpImage && (
        <img
          src={ogpImage}
          alt={title}
          class="w-full h-auto rounded-lg mb-8 not-prose"
        />
      )}
      <TableOfContents headings={headings} variant="inline" />
      <Content />
      {series && <SeriesBox seriesName={series.name} items={seriesItems} currentId={entry.id} />}
      <div class="divider not-prose"></div>
      <div class="not-prose">
        <a
          href={tweetIntentUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
          記事をシェア
        </a>
      </div>
    </article>

    {tocItems.length > 1 && (
      <aside class="hidden lg:block lg:w-64 lg:shrink-0">
        <div class="sticky top-20">
          <TableOfContents headings={headings} variant="sidebar" />
        </div>
      </aside>
    )}
  </div>

  <dialog id="mermaid-modal" class="modal">
    <div class="modal-box w-11/12 max-w-5xl overflow-auto">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
      </form>
      <div class="flex items-center gap-1 mb-2 not-prose">
        <button id="mermaid-zoom-out" type="button" class="btn btn-sm btn-circle btn-ghost" aria-label="縮小">－</button>
        <span id="mermaid-zoom-level" class="text-sm tabular-nums w-12 text-center">100%</span>
        <button id="mermaid-zoom-in" type="button" class="btn btn-sm btn-circle btn-ghost" aria-label="拡大">＋</button>
        <button id="mermaid-zoom-reset" type="button" class="btn btn-sm btn-ghost">リセット</button>
      </div>
      <div id="mermaid-modal-content" class="flex justify-start"></div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <script>
    async function renderMermaid() {
      const blocks = Array.from(
        document.querySelectorAll<HTMLElement>(
          'article pre[data-language="mermaid"]',
        ),
      );
      if (blocks.length === 0) return;

      const mermaid = (await import("mermaid")).default;

      const currentTheme = () =>
        document.documentElement.getAttribute("data-theme") === "dark"
          ? "dark"
          : "default";

      const containers = blocks.map((pre) => {
        const source = pre.textContent ?? "";
        const div = document.createElement("div");
        div.className = "mermaid flex justify-center cursor-zoom-in";
        div.dataset.mermaidSource = source;
        div.textContent = source;

        const figure = document.createElement("figure");
        figure.className = "not-prose my-6";
        figure.append(div);

        const figcaption = document.createElement("figcaption");
        figcaption.textContent = "（クリックで拡大表示できます）";
        figure.append(figcaption);

        pre.replaceWith(figure);
        return div;
      });

      const modal = document.getElementById("mermaid-modal") as HTMLDialogElement | null;
      const modalContent = document.getElementById("mermaid-modal-content");
      const zoomInBtn = document.getElementById("mermaid-zoom-in");
      const zoomOutBtn = document.getElementById("mermaid-zoom-out");
      const zoomResetBtn = document.getElementById("mermaid-zoom-reset");
      const zoomLevelLabel = document.getElementById("mermaid-zoom-level");

      const ZOOM_STEP = 0.25;
      const ZOOM_MIN = 0.5;
      const ZOOM_MAX = 3;
      let zoomLevel = 1;

      const applyZoom = () => {
        if (!modalContent) return;
        modalContent.style.transform = `scale(${zoomLevel})`;
        modalContent.style.transformOrigin = "top left";
        if (zoomLevelLabel) {
          zoomLevelLabel.textContent = `${Math.round(zoomLevel * 100)}%`;
        }
      };

      zoomInBtn?.addEventListener("click", () => {
        zoomLevel = Math.min(ZOOM_MAX, zoomLevel + ZOOM_STEP);
        applyZoom();
      });
      zoomOutBtn?.addEventListener("click", () => {
        zoomLevel = Math.max(ZOOM_MIN, zoomLevel - ZOOM_STEP);
        applyZoom();
      });
      zoomResetBtn?.addEventListener("click", () => {
        zoomLevel = 1;
        applyZoom();
      });

      containers.forEach((div) => {
        div.addEventListener("click", () => {
          const svg = div.querySelector("svg");
          if (!svg || !modal || !modalContent) return;
          const clone = svg.cloneNode(true) as SVGElement;
          clone.removeAttribute("width");
          clone.removeAttribute("height");
          clone.style.maxWidth = "none";
          clone.style.width = "100%";
          clone.style.height = "auto";
          modalContent.replaceChildren(clone);
          zoomLevel = 1;
          applyZoom();
          modal.showModal();
        });
      });

      const draw = async () => {
        mermaid.initialize({ startOnLoad: false, theme: currentTheme() });
        containers.forEach((div) => {
          div.removeAttribute("data-processed");
          div.textContent = div.dataset.mermaidSource ?? "";
        });
        await mermaid.run({ nodes: containers });
      };

      await draw();

      // テーマ切り替えボタンでdata-theme属性が変わったら再描画する
      new MutationObserver(draw).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }

    renderMermaid();
  </script>

  <script>
    function initTocHighlight() {
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
      );
      if (links.length === 0) return;

      const ACTIVE_CLASSES = ["bg-primary/10", "text-primary", "font-medium"];

      const setActive = (slug: string | null) => {
        links.forEach((link) => {
          const isActive =
            slug !== null && link.getAttribute("href") === `#${slug}`;
          ACTIVE_CLASSES.forEach((cls) => link.classList.toggle(cls, isActive));
        });
      };

      const slugToEl = new Map<string, HTMLElement>();
      links.forEach((link) => {
        const slug = link.getAttribute("href")?.slice(1);
        if (!slug || slugToEl.has(slug)) return;
        const el = document.getElementById(slug);
        if (el) slugToEl.set(slug, el);
      });

      let activeSlug: string | null = null;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              activeSlug = entry.target.id;
            }
          });
          setActive(activeSlug);
        },
        { rootMargin: "-96px 0px -70% 0px", threshold: 0 },
      );

      slugToEl.forEach((el) => observer.observe(el));
    }

    initTocHighlight();
  </script>

  <script>
    function initCodeCopyButtons() {
      const blocks = Array.from(
        document.querySelectorAll<HTMLPreElement>(
          'article pre.astro-code:not([data-language="mermaid"])',
        ),
      );

      blocks.forEach((pre) => {
        const wrapper = document.createElement("div");
        wrapper.className = "code-block-wrapper group relative";
        pre.replaceWith(wrapper);
        wrapper.appendChild(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.textContent = "Copy";
        button.className =
          "absolute top-2 right-2 rounded bg-white/10 px-2 py-1 text-xs text-white/80 opacity-0 backdrop-blur-sm transition-opacity hover:bg-white/20 hover:text-white group-hover:opacity-100 group-focus-within:opacity-100";

        let resetTimer: ReturnType<typeof setTimeout> | undefined;
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(pre.textContent ?? "");
            button.textContent = "Copied!";
          } catch {
            button.textContent = "Failed";
          }
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            button.textContent = "Copy";
          }, 1500);
        });

        wrapper.appendChild(button);
      });
    }

    initCodeCopyButtons();
  </script>
</BaseLayout>
