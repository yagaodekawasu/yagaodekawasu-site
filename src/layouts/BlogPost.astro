---
import type { CollectionEntry } from "astro:content";
import { render, getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, tags, ogpImage } = entry.data;

const { Content, headings } = await render(entry);

const profiles = await getCollection("profile");
const authorName = profiles[0]?.data.name;

const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
const shareText = `${title} | 笶顔でかわす`;
const tweetIntentUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(ogpImage && { image: new URL(ogpImage, Astro.site).toString() }),
  ...(authorName && { author: { "@type": "Person", name: authorName } }),
};
---

<BaseLayout title={`${title} | 笶顔でかわす`} description={description} ogImage={ogpImage} ogType="article" jsonLd={jsonLd}>
  <article class="prose max-w-none">
    {tags.length > 0 && (
      <div class="flex gap-2 mb-3 not-prose">
        {tags.map((tag) => (
          <span class="badge badge-outline">{tag}</span>
        ))}
      </div>
    )}
    <h1>{title}</h1>
    <div class="text-sm text-base-content/60 mb-6">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString("ja-JP")}
      </time>
      {updatedDate && (
        <span> (更新: {updatedDate.toLocaleDateString("ja-JP")})</span>
      )}
    </div>
    {ogpImage && (
      <img
        src={ogpImage}
        alt={title}
        class="w-full h-auto rounded-lg mb-8 not-prose"
      />
    )}
    <TableOfContents headings={headings} />
    <Content />
    <div class="divider not-prose"></div>
    <div class="not-prose">
      <a
        href={tweetIntentUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline btn-sm gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
        </svg>
        記事をシェア
      </a>
    </div>
  </article>

  <script>
    async function renderMermaid() {
      const blocks = Array.from(
        document.querySelectorAll<HTMLElement>(
          'article pre[data-language="mermaid"]',
        ),
      );
      if (blocks.length === 0) return;

      const mermaid = (await import("mermaid")).default;

      const currentTheme = () =>
        document.documentElement.getAttribute("data-theme") === "dark"
          ? "dark"
          : "default";

      const containers = blocks.map((pre) => {
        const source = pre.textContent ?? "";
        const div = document.createElement("div");
        div.className = "mermaid not-prose flex justify-center my-6";
        div.dataset.mermaidSource = source;
        div.textContent = source;
        pre.replaceWith(div);
        return div;
      });

      const draw = async () => {
        mermaid.initialize({ startOnLoad: false, theme: currentTheme() });
        containers.forEach((div) => {
          div.removeAttribute("data-processed");
          div.textContent = div.dataset.mermaidSource ?? "";
        });
        await mermaid.run({ nodes: containers });
      };

      await draw();

      // テーマ切り替えボタンでdata-theme属性が変わったら再描画する
      new MutationObserver(draw).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }

    renderMermaid();
  </script>
</BaseLayout>
