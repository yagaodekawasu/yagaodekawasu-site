---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{items.length > 1 && (
  <div class="collapse collapse-arrow bg-base-200 border border-base-300 mb-8 not-prose">
    <input type="checkbox" />
    <div class="collapse-title font-semibold">目次</div>
    <div class="collapse-content">
      <ul class="space-y-1">
        {items.map((heading) => (
          <li class={heading.depth === 3 ? "ml-4" : ""}>
            <a href={`#${heading.slug}`} class="link link-hover text-sm">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
)}
