---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, ogpImage } = post.data;
---

<a href={`/blog/${post.id}/`} class="card bg-base-200 hover:shadow-lg transition-shadow overflow-hidden">
  {ogpImage ? (
    <figure class="h-40">
      <img src={ogpImage} alt={title} width="600" height="340" class="w-full h-full object-cover" />
    </figure>
  ) : (
    <div class="h-40 flex items-end p-4 bg-gradient-to-br from-indigo-950 via-violet-900 to-indigo-950">
      <p class="text-white font-semibold leading-snug line-clamp-3">{title}</p>
    </div>
  )}
  <div class="card-body p-4">
    {ogpImage && <h3 class="card-title text-base">{title}</h3>}
    <time class="text-xs text-base-content/60" datetime={pubDate.toISOString()}>
      {pubDate.toLocaleDateString("ja-JP")}
    </time>
    <p class="text-sm text-base-content/70 line-clamp-2">{description}</p>
    {tags.length > 0 && (
      <div class="flex gap-2 flex-wrap mt-1">
        {tags.map((tag) => (
          <span class="badge badge-outline badge-sm">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>
