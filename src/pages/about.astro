---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import SocialIcon from "../components/SocialIcon.astro";

const profiles = await getCollection("profile");
const profile = profiles[0]?.data;
---

<BaseLayout title="About | 笶顔でかわす" description={profile?.bio ?? "プロフィール"}>
  <h1 class="text-3xl font-bold mb-6">About</h1>
  {profile ? (
    <div class="flex flex-col items-center text-center gap-4 sm:flex-row sm:text-left sm:items-start">
      {profile.avatar && (
        <img
          src={profile.avatar}
          alt={profile.name}
          width="120"
          height="120"
          class="rounded-full"
        />
      )}
      <div>
        <h2 class="text-xl font-semibold">{profile.name}</h2>
        <p class="mt-2 whitespace-pre-line">{profile.bio}</p>
        {profile.links.length > 0 && (
          <div class="flex gap-3 mt-4 flex-wrap justify-center sm:justify-start">
            {profile.links.map((link) => (
              <a
                href={link.url}
                class="text-base-content/70 hover:text-base-content transition-colors"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.label}
                title={link.label}
              >
                <SocialIcon icon={link.icon} class="h-7 w-7" />
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  ) : (
    <p class="text-base-content/60">プロフィールが未設定です。</p>
  )}
</BaseLayout>
